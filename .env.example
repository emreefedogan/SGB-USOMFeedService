# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun.
# .env dosyası .gitignore'dadır ve ASLA versiyon kontrolüne girmemelidir.

# ── Servis Kimliği ──
#
# Panoda (/) ve OpenAPI dokümantasyonunda (/docs) görünen ad. Kurumunuzun
# adını yansıtmak için burayı değiştirmeniz yeterli, kod değişikliği gerekmez.
#
# Varsayılan: "USOM Tehdit İstihbaratı Servisi"
SERVICE_TITLE="USOM Tehdit İstihbaratı Servisi"

# ── CrowdStrike Falcon API Kimlik Bilgileri ──

# CrowdStrike Falcon API Client ID (Indicators - Read/Write yetkisi gerekli)
FALCON_CLIENT_ID="YOUR_CLIENT_ID_HERE"

# CrowdStrike Falcon API Client Secret
FALCON_CLIENT_SECRET="YOUR_CLIENT_SECRET_HERE"

# Tenant'ınızın bulut bölgesi. Yanlış bölge kimlik doğrulamada 403 döndürür.
# Yaygın değerler: https://api.crowdstrike.com      (US-1, varsayılan)
#                  https://api.us-2.crowdstrike.com (US-2)
#                  https://api.eu-1.crowdstrike.com (EU-1)
FALCON_BASE_URL="https://api.crowdstrike.com"

# Domain ve IP göstergeleri için aksiyon.
# DİKKAT: CrowdStrike bu tiplerde "prevent" kabul etmez (HTTP 400 döner).
# Geçerli değerler: "detect" (alarm), "no_action", "allow"
FALCON_IOC_ACTION="detect"

# Zararlı yazılım hash'leri (sha256) için aksiyon.
# Hash tipinde "prevent" desteklenir ve dosyanın çalıştırılmasını engeller.
# Geçerli değerler: "prevent", "prevent_no_ui", "detect", "no_action", "allow"
#
# Öneri: ilk kurulumda "detect" ile başlayıp Falcon konsolunda tetiklenmeleri
# birkaç hafta izleyin. Hash beslemesi üçüncü taraftır (abuse.ch MalwareBazaar);
# yanlış pozitif bir kayıt "prevent" modunda meşru bir dosyayı kurum genelinde
# bloke eder.
FALCON_HASH_ACTION="prevent"

# CrowdStrike'a gönderimi, entegrasyonu tamamen kapatmadan durdurur.
#
# "false" yapıldığında göstergeler toplanmaya ve beslemelerden (/usom-ips,
# /usom-domains, /malware-hashes) sunulmaya devam eder, ancak CrowdStrike'a
# yeni gösterge BASILMAZ. Silme işlemleri (/indicators) çalışmaya devam eder.
#
# Ne zaman gerekir: tenant'ın 1 milyonluk gösterge limiti dolduğunda. Limit
# dolu iken gönderim her turda reddedilir, kod batch'i tek tek göstergeye
# kadar bölerek yeniden dener ve API'ye on binlerce baştan mahkûm istek gider.
# Bu bayrak o döngüyü, silme yeteneğini kaybetmeden durdurur.
#
# Varsayılan: true (tanımlanmazsa gönderim açıktır)
FALCON_PUSH_ENABLED="true"

# ── Brandefense Tehdit İstihbaratı (Opsiyonel) ──
#
# Tanımlanmazsa Brandefense kaynağı sessizce devre dışı kalır; USOM ve
# MalwareBazaar beslemeleri normal çalışmaya devam eder.
# BRANDEFENSE_API_KEY=""

# ── Saklama (Retention) Politikası ──
#
# CrowdStrike tenant başına 1 MİLYON gösterge kabul eder. Sınır dolduğunda
# yeni gösterge YAZILAMAZ — yani eski kayıtları tutmanın bedeli, en güncel
# tehditlerin EDR'a hiç ulaşmamasıdır. Saklama temizliği her gün 02:30'da
# çalışır, süresi dolmuş göstergeleri CrowdStrike'tan ve veritabanından
# kaldırarak sürekli yer açar.
#
# "Eski" ölçütü son GÖRÜLME tarihidir (last_seen_at), ilk ekleme değil:
# kaynak göstergeyi raporlamaya devam ettiği sürece süre yeniden başlar,
# böylece hâlâ aktif bir tehdit asla silinmez.
#
# Süresi dolup silinen bir gösterge, kaynak onu yeniden raporlarsa normal
# yoluyla GERİ GELİR. Panodaki "Sil" butonuyla yapılan operatör silmesinden
# farkı budur: o kalıcı dışlamadır, bu değildir.
#
# 0 = asla silme.

# Brandefense saatlik olarak 24 saatlik kayan pencere yayınlar, yani "son
# gözlemler" beslemesidir; bir kez görülüp bir daha raporlanmayan IOC
# doğal olarak bayatlar. En hızlı büyüyen kaynak budur (~10K/gün).
RETENTION_DAYS_BRANDEFENSE="30"

# MalwareBazaar "recent" dökümü de kayan penceredir; aynı mantık geçerli.
RETENTION_DAYS_MALWAREBAZAAR="30"

# USOM kayan pencere DEĞİL, güncel durum listesidir: API'nin döndüğü
# totalCount o an yayınlanan TÜM göstergeleri kapsar. Aylar önce eklenmiş
# bir domain bugün hâlâ listede olabilir ve çoğu öyledir. Yaşa göre silmek,
# hâlâ yayınlanan bir tehdidin korumasını kaldırmak olurdu.
# Bu yüzden varsayılan 0 — DEĞİŞTİRMEDEN ÖNCE İKİ KEZ DÜŞÜNÜN.
RETENTION_DAYS_USOM="0"

# Tek bir temizlik turunda silinebilecek azami gösterge. Yanlış
# yapılandırılmış bir TTL'in tenant'ı tek gecede boşaltmasını engelleyen
# emniyet freni. Sınıra takılan turlar log'a uyarı yazar; kalan kayıtlar
# bir sonraki turda temizlenir.
RETENTION_MAX_PER_RUN="50000"
